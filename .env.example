# ============================================================
# 环境变量模板 — 复制为 .env 后填写实际值
# 切勿将真实密钥提交到版本库
# ============================================================

# ========== 运行模式 ==========
DATASOURCE_MODE=synthetic           # synthetic | real
DEBUG=false
LOG_LEVEL=INFO

# ========== 数据库连接 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_procurement
MYSQL_USER=smart
MYSQL_PASSWORD=smart_procurement_dev
MYSQL_ROOT_PASSWORD=root_dev_pass
# SQLAlchemy async 连接串（优先于上面分项配置；compose 内会用 MYSQL_HOST 拼接）
MYSQL_URL=mysql+asyncmy://smart:smart_procurement_dev@localhost:3306/smart_procurement

# ========== Neo4j ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_pass

# ========== Milvus ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=bid_documents

# ========== MinIO ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_dev_pass
MINIO_BUCKET=bid-files
MINIO_PRESIGN_EXPIRY_SECONDS=1800

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== AI 服务 ==========
# AI 总开关：false 时 LLM 停用（断路器直接 OPEN），评审降级纯人工模式（P6.6 降级演示用）
DEEPSEEK_ENABLED=true
# DeepSeek API Key（必填，无则 /health/ready 中 deepseek 状态为 fail；演示 AI 评分/意图必须）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3
# 断路器熔断阈值：连续 N 次 5xx/超时后 OPEN（熔断 30s），OPEN 期间 AI 评分降级纯人工
DEEPSEEK_CIRCUIT_BREAKER_THRESHOLD=5
# BGE-M3 向量化服务端点（compose 内自动指向 http://bge-m3:8081；
# 本机开发连 http://localhost:8081；留空则 dev 模式 sentence-transformers 直连，需本机模型）
BGE_M3_ENDPOINT=http://localhost:8081

# ========== 安全 ==========
# JWT 签名密钥（必填，≥32 随机字符）。生成：openssl rand -hex 32
# 启动会强制校验：缺失/默认值/过短 → 拒绝启动（fail loud）
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
FERNET_KEY=                            # 身份证加密密钥，留空则自动生成（生产必填）

# ========== 业务参数 ==========
CONFLICT_EMPLOYMENT_YEARS=3
REVIEW_DEVIATION_THRESHOLD=0.15
FRAUD_AUTO_PASS_THRESHOLD=25
FRAUD_CRITICAL_THRESHOLD=75

# ========== 宿主端口映射（docker-compose 模板化，同机多栈端口冲突用） ==========
# docker-compose.yml 把宿主端口模板化为 ${VAR:-默认值}，不改本小节即用默认值；
# 同机跑多套栈端口冲突时在此覆盖。容器内部服务名互连不受影响，仅宿主访问端口变化。
# 联动提醒：MYSQL_PORT / MILVUS_PORT 已在「数据库连接」「Milvus」小节定义，compose 直接引用；
#           改 REDIS_PORT / BGE_M3_PORT 需同步 REDIS_URL / BGE_M3_ENDPOINT 里的端口。
REDIS_PORT=6379                 # Redis 宿主映射端口（REDIS_URL 需同步）
SP_APP_PORT=8002                # API 宿主映射端口（容器内部仍 8000；默认 8002）
BGE_M3_PORT=8081                # BGE-M3 宿主映射端口（BGE_M3_ENDPOINT 需同步）
WEB_PORT=8080                   # 前端宿主映射端口（nginx）
